# Root-level variables read by docker-compose.yml. Copy to .env (git-ignored) and edit.
# Application settings for the API live in apps/api/.env.example and are set in the compose file.

# --- Optional: public URL through ngrok (docker compose --profile share up) ---
# Free token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional fixed domain (one free static domain per ngrok account), e.g. my-lockers.ngrok-free.app
NGROK_URL=

# --- Accounts & login (defaults shown; override for anything beyond local use) ---
# One-click demo logins on the login page (codes returned by the API). Set false before exposing the stack.
# DEMO_MODE=true
# AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# PICKUP_CODE_SECRET=... and PICKUP_CODE_ENCRYPTION_KEY=... (both >= 32 chars, different from each other)
# SEED_ADMIN_EMAIL=admin@locker.local
# SEED_USERS=agent@locker.local:AGENT,alice@locker.local:CUSTOMER,bob@locker.local:CUSTOMER

# --- Email. Default: the Mailpit container (inbox at http://localhost:8025). For real delivery, e.g. Resend/SendGrid/Gmail SMTP:
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=465
# MAIL_SECURE=true
# MAIL_USER=resend
# MAIL_PASSWORD=re_...
# MAIL_FROM=Smart Package Locker <no-reply@yourdomain.com>

# --- Optional: host port overrides ---
# WEB_PORT_HOST=8080
# API_PORT_HOST=3000
# DB_PORT_HOST=5433
# NGROK_INSPECTOR_PORT_HOST=4040
# MAILPIT_PORT_HOST=8025
