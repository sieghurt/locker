# HTTP
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=locker
DB_PASSWORD=locker
DB_NAME=locker
DB_SSL=false

# Run pending TypeORM migrations on boot (true for docker/dev, false if you run them out of band)
DB_MIGRATIONS_RUN=true

# Secret (>= 32 chars) used to HMAC pickup codes before they are stored. Rotate = all outstanding codes stop working.
PICKUP_CODE_SECRET=change-me-to-a-long-random-string-before-production
PICKUP_CODE_LENGTH=6
# Separate key (>= 32 chars) that encrypts waiting pickup codes so an admin can read them out to a customer
PICKUP_CODE_ENCRYPTION_KEY=change-me-to-another-long-random-string-32-chars

# Level 3: storage charges. Day = 24h from the moment the package was stored, partial days round up.
# Tier 1: STORAGE_RATE_PER_DAY x1 for the first 5 days, tier 2: x2 for the next 5, tier 3: x3 after that.
STORAGE_RATE_PER_DAY=10
STORAGE_TIER_1_DAYS=5
STORAGE_TIER_2_DAYS=5
STORAGE_FREE_DAYS=0
STORAGE_CURRENCY=UNITS

# Per-IP rate limits (requests per minute)
RATE_LIMIT_PER_MINUTE=300
PICKUP_RATE_LIMIT_PER_MINUTE=10
# Wrong codes tolerated per package before its locker refuses pickups for PICKUP_LOCKOUT_MINUTES
PICKUP_MAX_FAILED_ATTEMPTS=5
PICKUP_LOCKOUT_MINUTES=15
# true when behind a reverse proxy / load balancer so per-IP limits use X-Forwarded-For
TRUST_PROXY=false

# --- Accounts & login ---
# Demo mode: login codes are returned in the API response and GET /api/auth/demo lists accounts. Refused in production.
DEMO_MODE=false
# Signs session cookies and keys the hash of emailed login codes (>= 32 chars). Rotating it logs everyone out.
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=12
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_10_MIN=3
OTP_RATE_LIMIT_PER_MINUTE=10
# First admin, created only when the users table is empty. Without it nobody can log in.
SEED_ADMIN_EMAIL=admin@locker.local
# Optional demo accounts (email:ROLE, comma separated), also only into an empty table
SEED_USERS=agent@locker.local:AGENT,alice@locker.local:CUSTOMER

# --- Email (login codes, pickup codes). Empty MAIL_HOST = log only, nothing is sent.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Smart Package Locker <no-reply@locker.local>

# Optional: seed lockers on boot when the lockers table is empty. Format: SIZE:COUNT,SIZE:COUNT
SEED_LOCKERS=SMALL:3,MEDIUM:2,LARGE:1
